<?xml version="1.0" encoding="utf-8"?>
<!--
   Yedekleme ve cihazdan cihaza aktarım kuralları (Android 12 ve üstü). G-050.
   İçerik veritabanları yedeğe/aktarıma GİRMEZ; tercihler (listeler, favoriler, izleme ilerlemesi)
   girer. Yedekten dönüşte içerik yeniden indirilir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
